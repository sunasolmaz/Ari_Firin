# =====================================================================
# Arı Fırın - Çevre Değişkenleri Şablonu (.env.example)
# =====================================================================
# Bu dosyayı '.env' olarak kopyalayıp kendi sunucu ve kimlik bilgilerinizi giriniz.

# --- Veritabanı Yapılandırması (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accounting_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# --- Uygulama Sürümü ---
APP_VERSION=1.0.5

# --- Merkezi Sunucu ve Güncelleme Servisi ---
SERVER_URL=http://localhost:8000
UPDATE_URL=http://localhost:8001/version.txt
UPDATE_DOWNLOAD_URL=http://localhost:8001/AriFirin_latest.zip
LICENSE_KEY=YOUR-LICENSE-KEY-HERE

# --- E-Posta / Bildirim Servisi (Gmail SMTP) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
